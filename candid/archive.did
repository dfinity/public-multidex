type UserEventKind = 
 variant {
   borrow: record {
             amount: nat;
             token: TokenId;
           };
   config: record {
             setter: text;
             value: text;
           };
   debtDelta: record {
                amount: int;
                token: TokenId;
              };
   delta: record {
            amount: int;
            token: TokenId;
          };
   deposit: DepositRecord;
   fill:
    record {
      marketId: MarketId;
      orderId: nat;
      price: nat;
      qty: nat;
      side: Side;
      tradeId: nat;
    };
   gap: record {
          fromSeq: nat;
          toSeq: nat;
        };
   insShareDelta: record {amount: int;};
   insuranceStake: record {
                     amountUsd: nat;
                     shares: nat;
                   };
   insuranceUnstake: record {
                       payoutUsd: nat;
                       shares: nat;
                     };
   liquidation: LiquidationEvent;
   lpDeposit:
    record {
      baseAmount: nat;
      lpMinted: nat;
      marketId: MarketId;
      quoteAmount: nat;
    };
   lpShareDelta: record {
                   amount: int;
                   marketId: MarketId;
                 };
   lpWithdraw: record {
                 basket: vec record {
                               TokenId;
                               nat;
                             };
                 lpBurned: nat;
               };
   orderClosed: ClosedOrderRecord;
   repay: record {
            amount: nat;
            token: TokenId;
          };
 };
type UserEvent = 
 record {
   counterparty: opt principal;
   kind: UserEventKind;
   prevHash: opt blob;
   seq: nat;
   ts: int;
   user: principal;
 };
type TokenId = text;
type Side = 
 variant {
   buy;
   sell;
 };
type OrderType = 
 variant {
   limit;
   market;
 };
type OrderStatus = 
 variant {
   cancelled;
   filled;
   open;
   partiallyFilled;
 };
type MarketId = text;
type LiquidationEvent = 
 record {
   collateralSeized: nat;
   collateralToken: TokenId;
   debtRepaid: nat;
   debtRepaidUsd: nat;
   debtToken: TokenId;
   healthAfter: nat;
   healthBefore: nat;
   penaltyUsd: nat;
   proceedsUsd: nat;
   timestamp: int;
   user: principal;
 };
type DepositRecord = 
 record {
   amount: nat;
   kind: variant {
           deposit;
           withdrawal;
         };
   timestamp: int;
   token: TokenId;
 };
type ClosedOrderRecord = 
 record {
   closedAt: int;
   filled: nat;
   id: nat;
   marketId: MarketId;
   orderType: OrderType;
   placedAt: int;
   price: nat;
   quantity: nat;
   side: Side;
   status: OrderStatus;
 };
type Archive = 
 service {
   appendBatch: (events: vec UserEvent) ->
    (variant {
       err: text;
       full: nat;
       ok: nat;
     });
   backfillDwIndex: (maxScan: nat) ->
    (record {
       cursor: nat;
       done: bool;
       dwCount: nat;
       scanned: nat;
       total: nat;
     });
   getCertifiedHead: () ->
    (record {
       certificate: opt blob;
       chainStartSeq: opt nat;
       headHash: opt blob;
       headSeq: opt nat;
     }) query;
   getDepositWithdrawals: (offset: nat, limit: nat) -> (vec UserEvent) query;
   getEventsForPrincipals: (principals: vec principal, offset: nat, limit:
    nat) -> (record {
               events: vec UserEvent;
               total: nat;
             }) query;
   getEventsForPrincipalsFiltered: (principals: vec principal, kinds:
    vec text, offset: nat, limit: nat) ->
    (record {
       events: vec UserEvent;
       total: nat;
     }) query;
   getEventsRange: (startSeq: nat, limit: nat) -> (vec UserEvent) query;
   getMyEvents: (offset: nat, limit: nat) ->
    (record {
       events: vec UserEvent;
       total: nat;
     }) query;
   stats: () ->
    (record {
       bytes: nat64;
       chainHead: opt blob;
       chainStartSeq: opt nat;
       cycles: nat;
       dwIndexCursor: opt nat;
       eventCount: nat;
       fillIndexCursor: opt nat;
       firstSeq: opt nat;
       heapLiveBytes: nat;
       lowMemoryAtNs: int;
       lowMemoryCount: nat;
       memorySizeBytes: nat;
       nextSeq: nat;
       users: nat;
     }) query;
   verifyChain: (fromSeq: nat, limit: nat) ->
    (record {
       brokenAt: opt nat;
       checked: nat;
       linksChecked: nat;
       nextSeq: opt nat;
       ok: bool;
     }) query;
 };
service : (owner: principal) -> Archive
