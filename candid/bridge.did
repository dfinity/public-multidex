type DepositView = 
 record {
   address: text;
   asset: text;
   chain: text;
   claimable: nat;
   claimed: nat;
   confirmed: nat;
   pending: nat;
 };
type ChainAddress = 
 record {
   address: text;
   asset: text;
   chain: text;
 };
