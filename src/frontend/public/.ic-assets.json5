[
  // THIS is the file that ships. vite's root is src/frontend and only
  // publicDir (src/frontend/public) is copied verbatim into dist/ — which is
  // what the asset canister syncs and reads. A sibling src/frontend/.ic-assets.json5
  // sits at the vite ROOT and is therefore NEVER copied, so rules placed
  // there silently do nothing (that is how the caching / raw-access / security
  // rules below went missing from every deployment until 2026-07-23).
  // Verify after changing: curl -sD- -o/dev/null <origin>/ and check the headers.

  // .well-known/ is where agent-discovery files live (ic-app.json — see
  // vite.config.js's emitWellKnownManifest). The asset sync SKIPS dot-paths
  // by default, so without this rule the directory never reaches the
  // canister and the SPA fallback serves index.html in its place — which
  // discovery tooling correctly ignores.
  { "match": ".well-known", "ignore": false },
  { "match": ".well-known/**/*", "ignore": false },

  // Everything: revalidate every load (index.html must never go stale — it
  // names the content-hashed bundle), and refuse raw.icp0.io, whose responses
  // BYPASS certification: a raw URL can serve modified JS to a signed-in
  // trader with no cryptographic check.
  //
  // security_policy "standard" is what actually emits a Content-Security-Policy
  // (plus X-Content-Type-Options, Referrer-Policy, X-Frame-Options and friends).
  // Without it the deployed app shipped NO CSP at all — certified assets prove
  // the bytes came from the canister, but say nothing about what those bytes are
  // then allowed to load. `script-src 'self'` is only affordable because the app
  // now bundles every script it runs (the lightweight-charts CDN <script> is
  // gone) and emits no inline event-handler attributes.
  {
    "match": "**/*",
    "security_policy": "standard",
    "headers": {
      "Cache-Control": "public, max-age=0, must-revalidate",
    },
    "allow_raw_access": false,
  },

  // Content-hashed build output (assets/index-<hash>.js, fonts, sprites) —
  // the name changes whenever the bytes do, so it can be cached hard.
  {
    "match": "assets/**/*",
    "headers": {
      "Cache-Control": "public, max-age=31536000, immutable",
    },
  },

  // IC App Connect bridge page (ai-connect.html) — its OWN policy, which
  // replaces the `standard` one above for this file. Two reasons it cannot just
  // inherit: the page carries an inline handshake script (pinned by hash below
  // rather than allowed wholesale with 'unsafe-inline'), and `standard`
  // includes `upgrade-insecure-requests`, which would rewrite the connector
  // callback `http://127.0.0.1:<port>/callback` to https and break every
  // sign-in. So: nothing loads by default; the one script that may run is that
  // exact byte sequence; the only place the page may talk to is loopback.
  //
  // THE HASH PINS THE SCRIPT BYTES. Editing the script without updating it here
  // takes the page down — `node tests/frontend_security.test.mjs` checks the
  // two are in step and prints the replacement value.
  //
  // frame-ancestors 'none' was already here and stays: a clickjacking overlay
  // must not be able to trick the user into approving the II sign-in.
  {
    "match": "ai-connect.html",
    "headers": {
      // One line on purpose: JSON5 has no string concatenation, and a
      // backslash line-continuation is not worth betting a deploy on.
      "Content-Security-Policy": "default-src 'none'; script-src 'sha256-s7iO84RG69oGxUSyWJL9PiosgUKEYh18SK1dhXWbsU4='; style-src 'unsafe-inline'; connect-src http://127.0.0.1:*; img-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
    },
  },
]
